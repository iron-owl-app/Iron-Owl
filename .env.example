# FinTrack configuration. Copy to `.env` (never commit `.env`) and fill in.

# Plaid keys. The usual way is to leave these empty and enter your keys in the app under
# Settings -> Bank connection (they're stored encrypted in your vault). Keys set here take
# priority over the ones saved in the app, and the app then shows them read-only.
# Plaid API client id from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
# Plaid secret for the chosen environment (sandbox and production secrets differ). Never share or log it.
PLAID_SECRET=
# Plaid environment: "sandbox" (fake test institutions) or "production" (real banks)
PLAID_ENV=sandbox

# Minutes without an authenticated request before the server locks the database (1-1440)
AUTO_LOCK_MINUTES=15
# Who to call about a forgotten password or lost recovery sheet (up to 60 characters), shown
# on the unlock screen, e.g. SUPPORT_CONTACT=Sam. Empty: "the person who set up FinTrack".
SUPPORT_CONTACT=
# Interface to bind. Must be loopback; run.py refuses anything else.
HOST=127.0.0.1
# Port for the API and the built frontend (http://127.0.0.1:PORT)
PORT=8000

# Where fintrack.db (encrypted) and keyfile.json live. Defaults to <repo>/data
# DATA_DIR=<repo>/data

# Built frontend served at "/". Defaults to <repo>/frontend/dist
# FRONTEND_DIST=<repo>/frontend/dist

# 1 = also accept Host/Origin localhost:5173 / 127.0.0.1:5173 (the Vite dev server). Leave 0 for normal use.
DEV=0
# Port of the Vite dev server allowed when DEV=1
DEV_PORT=5173
# 1 = enable /docs, /redoc and /openapi.json. Leave 0 for normal use.
DEBUG=0

# Installed copies only: where updates come from. Leave empty to use what the install chose
# (emailed .ftupdate files, or GitHub releases for Iron Owl downloaded from GitHub).
# file = only update files you're sent; github = check GitHub once a day; off = no updates.
# UPDATE_SOURCE=
